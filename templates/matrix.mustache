                b.disabled = false;
            });
        });
    }

    /**
     * Sends the completion notification for one course's box. Only ever
     * called after the user has confirmed via window.confirm() in the
     * click delegate above — this function itself does not ask again.
     * Deliberately repeatable: no client-side check for "already sent".
     */
    function sendCompletionNotification(box) {
        var courseid  = parseInt(box.dataset.courseid, 10);
        var studentid = parseInt(box.dataset.studentid, 10);
        var url       = box.dataset.finalstatusurl;
        var sesskey   = box.dataset.sesskey;
        var statusEl  = box.querySelector('.nvq-finalstatus-status');

        if (!url || !courseid || !studentid) { return; }

        box.dataset.saving = '1';
        box.querySelectorAll('.nvq-finalstatus-btn, .nvq-finalstatus-clear, .nvq-finalstatus-notify').forEach(function (b) {
            b.disabled = true;
        });

        if (statusEl) {
            statusEl.textContent = '';
            statusEl.className   = 'nvq-finalstatus-status nvq-grade-saving';
        }

        var body = new URLSearchParams({
            studentid : studentid,
            courseid  : courseid,
            action    : 'notify',
            sesskey   : sesskey,
        });

        fetch(url, {
            method      : 'POST',
            credentials : 'same-origin',
            headers     : { 'Content-Type': 'application/x-www-form-urlencoded' },
            body        : body.toString(),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                reloadPreservingEditMode(box);
                return;
            }
            if (statusEl) {
                statusEl.textContent = data.error || 'Error';
                statusEl.className   = 'nvq-finalstatus-status nvq-grade-error';
            }
        })
        .catch(function () {
            if (statusEl) {
                statusEl.textContent = 'Error sending notification';
                statusEl.className   = 'nvq-finalstatus-status nvq-grade-error';
            }
        })
        .finally(function () {
            box.dataset.saving = '0';
            box.querySelectorAll('.nvq-finalstatus-btn, .nvq-finalstatus-clear, .nvq-finalstatus-notify').forEach(function (b) {
                b.disabled = false;
            });
        });
    }

    /**
     * Saves the evidence type checkboxes for a single evidence item.
     * Entirely independent of the item's comment — separate endpoint
     * (evidence_type.php), separate DB write, no shared attribution.
     *
     * Takes the popover container (not a single checkbox) since a change
     * to any one checkbox needs to resubmit the whole current selection —
     * save_evidence_type() always replaces the full set server-side.
     */
    function saveEvidenceType(popover) {
        if (!popover) { return; }

        var mmid            = parseInt(popover.dataset.mmid, 10);
        var itemid           = parseInt(popover.dataset.itemid, 10);
        var studentid        = parseInt(popover.dataset.studentid, 10);
        var evidencetypeurl  = popover.dataset.evidencetypeurl;
        var checkboxes       = popover.querySelectorAll('.nvq-evidencetype-checkbox');
        var checked          = Array.prototype.filter.call(checkboxes, function (cb) { return cb.checked; });
        var selectedcodes    = checked.map(function (cb) { return cb.value; });
        var selectedlabels   = checked.map(function (cb) {
            var span = cb.nextElementSibling;
            return span ? span.textContent : cb.value;
        });

        var wrap             = popover.closest('.nvq-evidencetype-wrap');
        var statusEl         = wrap ? wrap.querySelector('.nvq-evidencetype-status') : null;
        var valueEl          = wrap ? wrap.querySelector('.nvq-evidencetype-value') : null;

        var matrix   = popover.closest('.block-nvq-matrix');
        var sesskey  = matrix ? matrix.dataset.sesskey : '';

        // courseid: pulled from the unit summary block, same as saveItemComment —
        // the evidence type table doesn't carry one of its own.
        var unitcard = popover.closest('.nvq-unit-card');
        var summary  = unitcard ? unitcard.querySelector('.nvq-unit-grade-summary') : null;
        var courseid = summary ? parseInt(summary.dataset.courseid, 10) : 0;

        if (!evidencetypeurl || !mmid || !itemid || !studentid || !courseid) { return; }

        checkboxes.forEach(function (cb) { cb.disabled = true; });

        if (statusEl) {
            statusEl.textContent = '';
            statusEl.className   = 'nvq-evidencetype-status nvq-grade-saving';
        }

        var body = new URLSearchParams();
        body.set('mmid', mmid);
        body.set('itemid', itemid);
        body.set('studentid', studentid);
        body.set('courseid', courseid);
        body.set('sesskey', sesskey);
        selectedcodes.forEach(function (code) { body.append('evidencetype[]', code); });

        fetch(evidencetypeurl, {
            method      : 'POST',
            credentials : 'same-origin',
            headers     : { 'Content-Type': 'application/x-www-form-urlencoded' },
            body        : body.toString(),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success && valueEl) {
                // Reflect the new choice in the display text immediately —
                // the display span stays hidden behind the popover while
                // edit mode is on, but this keeps it correct for the
                // instant edit mode is switched off again, with no reload.
                valueEl.textContent = selectedlabels.length ? selectedlabels.join(', ') : valueEl.dataset.notsettext;
                valueEl.classList.toggle('nvq-evidencetype-value--unset', selectedlabels.length === 0);
            }
            if (statusEl) {
                statusEl.textContent = data.success ? '\u2713' : (data.error || 'Error');
                statusEl.className   = 'nvq-evidencetype-status ' + (data.success ? 'nvq-grade-saved' : 'nvq-grade-error');
                setTimeout(function () {
                    if (statusEl) { statusEl.textContent = ''; statusEl.className = 'nvq-evidencetype-status'; }
                }, 3000);
            }
        })
        .catch(function () {
            if (statusEl) {
                statusEl.textContent = 'Error';
                statusEl.className   = 'nvq-evidencetype-status nvq-grade-error';
            }
        })
        .finally(function () {
            checkboxes.forEach(function (cb) { cb.disabled = false; });
        });
    }

    /**
     * Saves the unit-level sampling status dropdown.
     */
    function saveSampling(select) {
        var summary   = select.closest('.nvq-unit-sample-summary');
        if (!summary) { return; }

        var topicid   = parseInt(summary.dataset.topicid, 10);
        var studentid = parseInt(summary.dataset.studentid, 10);
        var courseid  = parseInt(summary.dataset.courseid, 10);
        var status    = parseInt(select.value, 10);
        var statusEl  = summary.querySelector('.nvq-sample-status');

        var matrix     = summary.closest('.block-nvq-matrix');
        var sampleurl  = matrix ? matrix.dataset.sampleurl : '';
        var sesskey    = matrix ? matrix.dataset.sesskey   : '';

        if (!sampleurl || !courseid) { return; }

        select.disabled = true;

        if (statusEl) {
            statusEl.textContent = '';
            statusEl.className   = 'nvq-sample-status mt-1 nvq-grade-saving';
        }

        var body = new URLSearchParams({
            topicid   : topicid,
            studentid : studentid,
            courseid  : courseid,
            status    : status,
            sesskey   : sesskey,
        });

        fetch(sampleurl, {
            method      : 'POST',
            credentials : 'same-origin',
            headers     : { 'Content-Type': 'application/x-www-form-urlencoded' },
            body        : body.toString(),
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (statusEl) {
                if (data.success) {
                    statusEl.textContent = data.message || '\u2713';
                    statusEl.className   = 'nvq-sample-status mt-1 nvq-grade-saved';
                    syncHeaderSampleBadge(topicid, status);
                    syncSampleReadonlyDisplay(summary, status);
                } else {
                    statusEl.textContent = data.error || 'Error';
                    statusEl.className   = 'nvq-sample-status mt-1 nvq-grade-error';
                }
                setTimeout(function () {
                    if (statusEl) { statusEl.textContent = ''; statusEl.className = 'nvq-sample-status mt-1'; }
                }, 3000);
            }
        })
        .catch(function () {
            if (statusEl) {
                statusEl.textContent = 'Error saving';
                statusEl.className   = 'nvq-sample-status mt-1 nvq-grade-error';
            }
        })
        .finally(function () {
            select.disabled = false;
        });
    }

    /**
     * Updates the compact sampling badge in the unit header after a save
     * from the bottom summary dropdown, so both stay in sync.
     */
    function syncHeaderSampleBadge(topicid, status) {
        var badge = document.querySelector('.nvq-header-sample-badge-' + topicid);
        if (!badge) { return; }

        badge.classList.remove(
            'nvq-sample-badge--sampled',
            'nvq-sample-badge--notyetsampled',
            'nvq-sample-badge--blank'
        );

        if (status === 1) {
            badge.classList.add('nvq-sample-badge--sampled');
            badge.textContent = badge.dataset.sampledtext;
        } else if (status === 2) {
            badge.classList.add('nvq-sample-badge--notyetsampled');
            badge.textContent = badge.dataset.notyetsampledtext;
        } else {
            badge.classList.add('nvq-sample-badge--blank');
            badge.textContent = '';
        }
    }

    /**
     * Mirrors syncGradeReadonlyBadge() for the sampling read-only view —
     * rebuilds the badge/blank-text markup inside .nvq-sample-readonly so
     * re-locking via "Done editing" reflects the just-saved status without
     * a page reload. Labels come from data-*text attributes rendered
     * server-side onto .nvq-sample-readonly, not M.util.get_string() — see
     * the comment on syncGradeReadonlyBadge() for why.
     */
    function syncSampleReadonlyDisplay(summary, status) {
        var readonly = summary.querySelector('.nvq-sample-readonly');
        if (!readonly) { return; }

        if (status === 1) {
            readonly.innerHTML = '<span class="nvq-sample-badge nvq-sample-badge--sampled"></span>';
            readonly.firstChild.textContent = readonly.dataset.sampledtext;
        } else if (status === 2) {
            readonly.innerHTML = '<span class="nvq-sample-badge nvq-sample-badge--notyetsampled"></span>';
            readonly.firstChild.textContent = readonly.dataset.notyetsampledtext;
        } else {
            readonly.innerHTML = '<span class="nvq-sample-readonly-blank"></span>';
            readonly.firstChild.textContent = readonly.dataset.blanktext;
        }
    }

    // Init after DOM ready.
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initGrading);
    } else {
        initGrading();
    }
}());
</script>
